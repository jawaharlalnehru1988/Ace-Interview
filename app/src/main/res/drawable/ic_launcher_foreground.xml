<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle drop shadow behind the central emblem -->
    <path
        android:pathData="M54,37 L72,55 L54,73 L36,55 Z"
        android:fillColor="#33000000" />

    <!-- Left Code Bracket `<` -->
    <path
        android:pathData="M38,40 L28,54 L38,68"
        android:strokeWidth="5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Right Code Bracket `>` -->
    <path
        android:pathData="M70,40 L80,54 L70,68"
        android:strokeWidth="5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Central Ace Diamond -->
    <path
        android:pathData="M54,35 L68,54 L54,73 L40,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="35"
                android:endX="68"
                android:endY="73"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.6" android:color="#E0E7FF" />
                <item android:offset="1.0" android:color="#A5B4FC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Core Diamond Accent -->
    <path
        android:pathData="M54,44 L61,54 L54,64 L47,54 Z"
        android:fillColor="#4F46E5" />

    <!-- Spark Star on Top Right of Diamond -->
    <path
        android:pathData="M66,36 L68,30 L70,36 L76,38 L70,40 L68,46 L66,40 L60,38 Z"
        android:fillColor="#FBBF24" />
</vector>
